# ── Clave de Groq (gratis en https://console.groq.com → API Keys) ──
# Pega tu clave después del igual, sin comillas. Sirve para responder (Llama 3.3)
# y para transcribir audios y videos (Whisper).
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ── Anthropic Claude API Key (Opcional, https://console.anthropic.com) ──
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# ── JWT Configuration ──
# Cambia este texto por cualquier frase larga si vas a publicar la app
JWT_SECRET_KEY=archivo-vivo-cambia-esta-frase
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./chatpdf_expert.db

# ── Embeddings: EmbeddingGemma 2 servido por llama.cpp (local, gratis) ──
# run.bat arranca:  llama-server -hf unsloth/embeddinggemma-2-GGUF:UD-Q4_K_XL --embeddings --port 8081 --device none -ngl 0
LLAMACPP_EMBED_URL=http://127.0.0.1:8081
EMBED_DIM=768

# ── Audios y videos ──
# groq = Whisper large-v3-turbo en la nube (gratis) | local = faster-whisper en el PC
TRANSCRIBE_BACKEND=groq
MAX_MEDIA_MINUTES=20
VIDEO_FRAMES=4

# ── Visión (imágenes de PDFs y fotogramas de video) con Ollama ──
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# ── Base de conocimiento ──
MAX_PDF_PAGES=10

# ── PostgreSQL + pgvector (base de datos vectorial) ──
# usuario:contraseña@host:puerto/base_de_datos (la BD y la tabla se crean solas)
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5432/chatpdf

